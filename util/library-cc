#!/bin/sh

# Make unavailable libraries fail the normal configure/link probes in CI.
# The addon itself has no test-only feature switches.
for argument do
    library=
    case "$argument" in
        -lz) library=zlib ;;
        -lbrotlienc|-lbrotlicommon) library=brotli ;;
        -lzstd) library=zstd ;;
    esac

    if [ -n "$library" ]; then
        case " $TEST_COMPRESSION_LIBRARIES " in
            *" $library "*) ;;
            *) exit 1 ;;
        esac
    fi
done

if [ "${TEST_SANITIZE:-0}" = 1 ]; then
    exec sh "$(dirname "$0")/sanitizer-cc" "$@"
fi

exec "${CC:-cc}" "$@"
